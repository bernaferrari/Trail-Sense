<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="quickActionButtonStyle" format="reference" />

    <declare-styleable name="Toolbar">
        <attr name="leftButtonIcon" format="reference" />
        <attr name="rightButtonIcon" format="reference" />
        <attr name="title" format="string" />
        <attr name="subtitle" format="string" />
        <attr name="showSubtitle" format="boolean" />
        <attr name="flattenButtons" format="boolean" />
    </declare-styleable>

    <declare-styleable name="LinearCompassView">
        <attr name="backgroundColor" format="color" />
        <attr name="showMarker" format="boolean" />
        <attr name="markerColor" format="color" />
        <attr name="lineColor" format="color" />
        <attr name="cardinalLineColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="degrees" format="integer" />
        <attr name="rangeDegrees" format="float" />
    </declare-styleable>

    <declare-styleable name="DistanceInputView">
        <attr name="hint" format="string" />
    </declare-styleable>

    <declare-styleable name="CameraView">
        <attr name="flipEnable" format="boolean" />
    </declare-styleable>

    <declare-styleable name="TextInputView">
        <attr name="android:hint"/>
    </declare-styleable>

</resources>
